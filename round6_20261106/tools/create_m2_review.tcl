# Vivado2025.2 GUI review only. No synthesis/implementation/hardware commands.
# Everything generated by the existing BD script lives in an ignored cache.
set review_root [file normalize [file join [file dirname [info script]] ..]]
set review_cache [file join $review_root build m2_review.cache]
set review_project [file join $review_cache project kv260_m2_review.xpr]

if {[file exists $review_project]} {
    if {[llength [get_projects -quiet]]} {
        error "A project is already open. Open this review entry in its own Vivado session."
    }
    open_project $review_project
    puts "M2_REVIEW_EXISTING_PROJECT_OPENED=$review_project; NO_REGENERATION_OR_BUILD"
} else {
    if {[llength [get_projects -quiet]]} {
        error "Refusing to close or change an already-open project."
    }
    set published_root [file join $review_root fpga_c2]
    set board_root [file join $review_cache source_snapshot]
    if {[file exists $board_root]} {
        error "An incomplete review snapshot already exists at $board_root. Preserve it and inspect the previous log; this entry never overwrites it."
    }
    foreach required {
        rtl/kv260_unified_board_top.sv
        rtl/core/perception_axi_runtime_adapter.sv
        rtl/core/unified_perception_haptic_runtime.sv
        constraints/kv260_unified_pmod.xdc
        constraints/kv260_unified_cdc.xdc
        platform/ps_baseline_parameters.tcl
        platform/reference_ps.xci
        scripts/create_board_bd.tcl
        scripts/board_pre_opt.tcl
    } {
        if {![file isfile [file join $published_root $required]]} {
            error "Published M2 review dependency missing: $required"
        }
    }
    file mkdir $board_root
    foreach folder {rtl constraints platform scripts} {
        file copy [file join $published_root $folder] [file join $board_root $folder]
    }
    # Part copied from the proved D1 build entry, not inferred from the board name.
    create_project kv260_m2_review [file join $review_cache project] -part xck26-sfvc784-2LV-c
    set_property target_language Verilog [current_project]
    set_property simulator_language Mixed [current_project]
    proc review_collect_rtl {directory} {
        set files {}
        foreach entry [glob -nocomplain -directory $directory *] {
            if {[file isdirectory $entry]} {
                set files [concat $files [review_collect_rtl $entry]]
            } elseif {[file extension $entry] in {.v .sv .vh .svh}} {
                lappend files $entry
            }
        }
        return [lsort $files]
    }
    set review_rtl [review_collect_rtl [file join $board_root rtl]]
    if {![llength $review_rtl]} {error "No published RTL sources"}
    add_files -norecurse $review_rtl
    set review_pin_xdc [file join $board_root constraints kv260_unified_pmod.xdc]
    set review_cdc_xdc [file join $board_root constraints kv260_unified_cdc.xdc]
    add_files -fileset constrs_1 -norecurse [list $review_pin_xdc $review_cdc_xdc]
    set_property USED_IN_SYNTHESIS false [get_files $review_cdc_xdc]
    set_property USED_IN_IMPLEMENTATION true [get_files $review_cdc_xdc]
    # This existing script validates PS parameters, generates BD output products
    # and a wrapper; it does not launch synthesis or implementation runs.
    source [file join $board_root scripts create_board_bd.tcl]
    set_property top kv260_unified_board_top [get_filesets sources_1]
    set review_hook [file join $board_root scripts board_pre_opt.tcl]
    set fp [open $review_hook r]
    set review_hook_text [read $fp]
    close $fp
    if {[string first "0x52364d32" [string tolower $review_hook_text]] < 0} {
        error "Expected the frozen M2 pre-opt hook identity0x52364d32"
    }
    add_files -fileset utils_1 -norecurse $review_hook
    set_property STEPS.OPT_DESIGN.TCL.PRE $review_hook [get_runs impl_1]
    update_compile_order -fileset sources_1
    report_compile_order -used_in synthesis -file [file join $review_cache compile_order.rpt]
    puts "M2_REVIEW_PROJECT_CREATED=$review_project"
    puts "SOURCE_SNAPSHOT=$board_root; PART=xck26-sfvc784-2LV-c; TOP=kv260_unified_board_top"
    puts "REVIEW_ONLY; NO_SYNTHESIS; NO_PLACE_ROUTE; NO_BITSTREAM; NO_HARDWARE"
}
